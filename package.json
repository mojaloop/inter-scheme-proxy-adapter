{
  "name": "inter-scheme-proxy-adapter",
  "version": "1.8.2",
  "private": true,
  "description": "Schemes Proxy implementation (ISPA)",
  "license": "Apache-2.0",
  "author": "Eugen Klymniuk (geka-evk)",
  "contributors": [
    "Eugen Klymniuk <eugen.klymniuk@infitx.com>",
    "Steven Oderayi <steven.oderayi@infitx.com>"
  ],
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:build": "npm run build && npm start",
    "start:dev": "ts-node -r dotenv/config -P ./tsconfig.json src/index.ts",
    "test": "npm run test:unit",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch='**/unit/**/*.test.ts'",
    "test:xunit": "JEST_JUNIT_OUTPUT_DIR=./test/reports/ JEST_JUNIT_OUTPUT_NAME=xunit.xml npm run test:unit -- --reporters=jest-junit",
    "test:coverage": "npm run test:unit -- --coverage --coverageThreshold='{}'",
    "test:coverage-check": "npm run test:unit -- --coverage",
    "test:int": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch='**/test/integration/**/*.test.ts'",
    "test:functional": "echo \"ACTION: Add functional test here, or remove this script. Also check CI configs to comment out the necessary job'\"",
    "test:integration": "./test/scripts/test-integration.sh",
    "lint": "eslint ./src/**/*.ts ./test/**/*.ts",
    "lint:fix": "npm run lint -- --fix",
    "build": "tsc",
    "watch": "tsc -w",
    "script:token": "ts-node -r dotenv/config -P ./tsconfig.test.json ./test/scripts/getToken.ts",
    "script:tls": "ts-node -r dotenv/config -P ./tsconfig.test.json ./test/scripts/tlsExample.ts",
    "audit:fix": "npm audit fix",
    "audit:check": "npx audit-ci --config ./audit-ci.jsonc",
    "dep:check": "npx --no-install ncu -e 2",
    "dep:update": "npx --no-install ncu -u",
    "release": "npx standard-version --no-verify --releaseCommitMessageFormat 'chore(release): {{currentTag}} [skip ci]'",
    "snapshot": "npx standard-version --no-verify --skip.changelog --prerelease snapshot --releaseCommitMessageFormat 'chore(snapshot): {{currentTag}}'",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hapi/hapi": "^21.4.10",
    "@mojaloop/sdk-standard-components": "19.19.3",
    "axios": "1.20.0",
    "axios-retry": "4.5.0",
    "convict": "6.2.5",
    "fast-json-patch": "^3.1.1",
    "fast-safe-stringify": "^2.1.1",
    "joi": "18.3.0",
    "random-word-slugs": "^0.1.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/convict": "^6.1.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^25.3.1",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "audit-ci": "7.1.0",
    "axios-mock-adapter": "^2.1.0",
    "dotenv": "^18.0.8",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.6.0",
    "mock-socket": "^9.3.1",
    "npm-audit-resolver": "3.0.0-RC.0",
    "npm-check-updates": "23.1.1",
    "prettier": "3.9.10",
    "replace": "^1.2.2",
    "standard-version": "^9.5.0",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.x"
  },
  "overrides": {
    "form-data": "4.0.6",
    "shins": {
      "ajv": "6.12.3",
      "ejs": "3.1.10",
      "sanitize-html": "2.17.7",
      "yargs-parser": "21.1.1",
      "markdown-it": "14.3.1"
    },
    "widdershins": {
      "swagger2openapi": "7.0.8",
      "yargs-parser": "21.1.1",
      "markdown-it": "14.3.1"
    },
    "qs": "6.16.0",
    "validator": "13.15.22",
    "glob@10.4.5": "10.5.0",
    "diff": "8.0.3",
    "cross-spawn": "7.0.6",
    "axios": "1.20.0",
    "fast-xml-parser": "5.7.0",
    "lodash": "4.18.1",
    "minimatch@3.0.5": "3.1.5",
    "minimatch@5.1.6": "5.1.9",
    "handlebars": "4.7.10",
    "immutable": "5.1.8",
    "postcss": "8.5.23",
    "@grpc/grpc-js": "1.14.6",
    "@hapi/content": "6.0.2",
    "browserslist": "4.28.7",
    "fast-uri": "3.1.8",
    "flatted": "3.4.2",
    "linkify-it": "5.0.2",
    "path-to-regexp": "0.1.13",
    "nanoid": "3.3.18",
    "mysql2": "3.24.4",
    "@hapi/wreck": "18.1.2",
    "lodash-es": "4.18.1",
    "sanitize-html": "2.17.7",
    "body-parser": "1.20.6",
    "markdown-it": "14.3.1",
    "baseline-browser-mapping": "2.11.0",
    "follow-redirects": "1.16.0",
    "@babel/core": "7.29.6",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.7",
    "convict": "6.2.5",
    "joi@18": "18.3.0",
    "undici@6": "6.29.1",
    "undici@7": "7.29.1",
    "js-yaml@4": "4.3.2",
    "argparse@1": "2.0.1",
    "argparse@3": "3.0.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "protobufjs@7": "7.6.5"
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "replace '\\[mojaloop/#(\\d+)\\]\\(https://github.com/mojaloop/(.*)/issues/(\\d+)\\)' '[mojaloop/#$1](https://github.com/mojaloop/project/issues/$1)' CHANGELOG.md"
    }
  },
  "lint-staged": {
    "./src/*.ts": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "homepage": "https://github.com/mojaloop/inter-scheme-proxy-adapter#readme",
  "bugs": {
    "url": "https://github.com/mojaloop/inter-scheme-proxy-adapter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojaloop/inter-scheme-proxy-adapter.git"
  },
  "keywords": [
    "infitx",
    "mojaloop",
    "proxy",
    "inter-scheme-proxy-adapter"
  ]
}
